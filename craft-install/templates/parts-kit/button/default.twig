{#-
Sample part: a default button.
Parts are plain Twig fragments — no `{% layout %}`, rendered directly by the
plugin's root template. Clean URL: /parts-kit/button/default
-#}
<button type="button" style="
    font-family: system-ui, sans-serif;
    font-size: 1rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid #cbd2d9;
    border-radius: 6px;
    background: #f0f4f8;
    color: #1f2933;
    cursor: pointer;
">
    Default button
</button>
